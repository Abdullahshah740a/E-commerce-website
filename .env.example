NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional random 32+ character secret for checkout abuse-limit hashing.
# If blank, the server derives a separate HMAC key from SUPABASE_SECRET_KEY.
CHECKOUT_RATE_LIMIT_SECRET=
# Optional override of the owner-requested server-side Make default.
# Never prefix this with NEXT_PUBLIC_. Blank uses the default in order-webhooks.ts.
ORDER_WEBHOOK_URL=
# Set true only after branding, policies, real catalog and integration QA are complete.
STORE_LAUNCHED=false

